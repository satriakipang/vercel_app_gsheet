# ---------------------------------------------------------------
# 1. ID Google Sheet (ambil dari URL sheet-nya)
#    https://docs.google.com/spreadsheets/d/<INI_ID_NYA>/edit
# ---------------------------------------------------------------
GOOGLE_SHEET_ID=

# ---------------------------------------------------------------
# 2. Kredensial Service Account (Google Cloud > IAM > Service Accounts)
#    Share Sheet-nya ke email ini dengan akses Editor.
# ---------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=kol-manager@project-anda.iam.gserviceaccount.com

# Salin isi "private_key" dari file JSON, apa adanya, termasuk \n.
# Bungkus dengan tanda kutip ganda.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------
# 3. Opsional: kunci untuk melindungi endpoint tulis.
#    Kosongkan kalau app-nya internal / sudah di belakang Vercel Auth.
# ---------------------------------------------------------------
APP_PASSWORD=
